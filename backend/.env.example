# ──────────────────────────────────────────────
# SentinelX AI Backend - Environment Variables
# ──────────────────────────────────────────────

# ─── Server ───────────────────────────────────
NODE_ENV=development
PORT=5001
BASE_URL=http://localhost:5001
CLIENT_URL=http://localhost:3000

# ─── MongoDB ──────────────────────────────────
# Example: mongodb://localhost:27017/sentinelx-ai
# For Atlas: mongodb+srv://user:pass@cluster.mongodb.net/sentinelx-ai
MONGO_URI=mongodb://localhost:27017/sentinelx-ai

# ─── JWT Authentication ───────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=30d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-too
JWT_REFRESH_EXPIRE=30d
FRONTEND_URL=http://localhost:3000

# ─── Threat Intelligence APIs ─────────────────
# VirusTotal
VIRUSTOTAL_API_KEY=

# AbuseIPDB
ABUSEIPDB_API_KEY=

# Google Safe Browsing
GOOGLE_SAFE_BROWSING_API_KEY=

# AlienVault OTX
OTX_API_KEY=

# Shodan
SHODAN_API_KEY=

# URLScan.io
URLSCAN_API_KEY=

# NVD (National Vulnerability Database)
NVD_API_KEY=

# IPInfo
IPINFO_API_KEY=

# GreyNoise
GREYNOISE_API_KEY=

# Pulsedive
PULSEDIVE_API_KEY=

# Criminal IP
CRIMINALIP_API_KEY=

# ─── Cloudinary ───────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (Nodemailer) ───────────────────────
EMAIL_SERVICE=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM="SentinelX AI" <noreply@sentinelxai.com>

# Gmail OAuth (optional - for OAuth2 email)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground

