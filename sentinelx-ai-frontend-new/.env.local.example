# SentinelX AI Frontend — Environment Variables
#
# NEXT_PUBLIC_API_BASE_URL points the frontend at the backend API.
#
# Production (Render): leave unset to use the default below, OR set explicitly:
#   NEXT_PUBLIC_API_BASE_URL=https://cybercore-backend-csqd.onrender.com/api
#
# Local development: create a `.env.local` file with:
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:5001/api
#
# Copy this file to `.env.local` and adjust as needed.

NEXT_PUBLIC_API_BASE_URL=https://cybercore-backend-csqd.onrender.com/api
